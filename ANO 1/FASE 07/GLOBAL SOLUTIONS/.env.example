# ============================================================
# SatVerify — Template de variáveis de ambiente
# Copie este arquivo para `.env` e preencha com suas credenciais.
# NÃO faça commit do arquivo `.env` real.
# ============================================================

# ---- Copernicus Data Space Ecosystem (CDSE) ----
# Crie uma conta gratuita em https://dataspace.copernicus.eu/
# Depois gere um OAuth client em https://shapps.dataspace.copernicus.eu/dashboard/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ---- Mapbox ----
# Token de acesso público/privado obtido em https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# ---- Google Gemini (Google AI Studio) ----
# Gere uma API Key em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- AWS S3 ----
# Crie um usuário IAM no console AWS e gere as Access Keys.
# O bucket precisa existir previamente (crie em https://s3.console.aws.amazon.com/).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ---- Configurações da aplicação ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Parâmetros do Mapbox (imagens estáticas) ----
# Tamanho da imagem em pixels (lado do quadrado) e nível de zoom (1–22).
# 1024 é o mínimo recomendado para YOLO aéreo (DOTA) — abaixo disso os
# objetos ficam pequenos demais para detecção confiável. Máximo: 1280.
MAPBOX_IMAGE_SIZE=1024
MAPBOX_ZOOM_LEVEL=18

# ---- Parâmetros Sentinel ----
# Cobertura máxima de nuvens (%) aceita ao buscar imagens Sentinel-2.
SENTINEL_MAX_CLOUD_COVER=30
# Quantos dias para trás procurar imagens disponíveis.
SENTINEL_LOOKBACK_DAYS=60

# ---- Diretórios locais ----
CACHE_DIR=./data/cache
OUTPUT_DIR=./outputs
