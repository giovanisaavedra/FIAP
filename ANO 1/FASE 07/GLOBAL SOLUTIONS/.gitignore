# =============================================================================
# SatVerify — .gitignore
# =============================================================================


# -----------------------------------------------------------------------------
# 🔐 SEGREDOS E CREDENCIAIS (NUNCA commitar!)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
credentials.json
**/aws-credentials


# -----------------------------------------------------------------------------
# 🐍 PYTHON
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribuição / empacotamento
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Logs e relatórios de testes
*.log
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
coverage.xml
*.cover

# Jupyter
.ipynb_checkpoints
*.ipynb_checkpoints/


# -----------------------------------------------------------------------------
# 🏠 AMBIENTES VIRTUAIS
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.virtualenv/


# -----------------------------------------------------------------------------
# 🧠 MODELOS DE ML E DADOS
# -----------------------------------------------------------------------------
# Modelos baixados (são grandes e o YOLO baixa automaticamente)
*.pt
*.pth
*.h5
*.pkl
*.joblib
*.onnx
yolov8n.pt
yolov8s.pt
yolov8m.pt
yolov8l.pt
yolov8x.pt

# Datasets e dados de cache gerados (ex: cache do Hugging Face, datasets baixados, etc)
data/
!data/.gitkeep
*.csv
*.parquet
*.feather
*.hdf5


# -----------------------------------------------------------------------------
# 🛰️ IMAGENS E OUTPUTS DO PROJETO
# -----------------------------------------------------------------------------
outputs/
!outputs/.gitkeep

# Imagens geradas e baixadas
*.jpg
*.jpeg
*.png
*.tiff
*.tif
*.bmp
*.gif
*.webp

# Exceções: permite imagens em pasta de documentação/README
!docs/**/*.png
!docs/**/*.jpg
!assets/**/*.png
!assets/**/*.jpg
!README*.png


# -----------------------------------------------------------------------------
# 📊 RELATÓRIOS GERADOS
# -----------------------------------------------------------------------------
reports/
*.pdf
*.docx

# Exceções: permite PDFs de documentação (ex: README.pdf, apostilas)
!docs/**/*.pdf
!README*.pdf


# -----------------------------------------------------------------------------
# 💾 STREAMLIT
# -----------------------------------------------------------------------------
.streamlit/secrets.toml


# -----------------------------------------------------------------------------
# 💻 EDITORES E IDEs
# -----------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json

# JetBrains (PyCharm)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~


# -----------------------------------------------------------------------------
# 🖥️ SISTEMA OPERACIONAL
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# -----------------------------------------------------------------------------
# 📦 NODE / FRONTEND 
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# -----------------------------------------------------------------------------
# 🐳 DOCKER E DEPLOY 
# -----------------------------------------------------------------------------
.docker/
docker-compose.override.yml


# -----------------------------------------------------------------------------
# 📝 ARQUIVOS TEMPORÁRIOS DIVERSOS
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.old
tmp/
temp/
.scratch/
# Ferramenta auxiliar de build do PDF (não vai pro repo)
src/build_pdf.py
