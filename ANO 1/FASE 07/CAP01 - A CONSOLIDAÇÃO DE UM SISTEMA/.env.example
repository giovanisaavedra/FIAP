# =============================================================
# FarmTech Solutions - Configuração de Ambiente (Fase 5/7)
# -------------------------------------------------------------
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commitar o .env real. Mantenha-o no .gitignore.
# =============================================================

# ---- AWS / SNS ---------------------------------------------
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:farmtech-alertas
AWS_ACCESS_KEY_ID=AKIA_SEU_ACCESS_KEY_AQUI
AWS_SECRET_ACCESS_KEY=SEU_SECRET_ACCESS_KEY_AQUI

# ---- Limiares de alertas (Fase 5) --------------------------
# Umidade do solo (%) abaixo da qual disparamos alerta CRÍTICO
ALERTA_UMIDADE_CRITICA=20
# Faixa de pH considerada aceitável; fora dela = alerta ALTO
ALERTA_PH_MIN=5.0
ALERTA_PH_MAX=8.0
# Temperatura (°C) acima da qual disparamos alerta ALTO
ALERTA_TEMP_MAX=40
# Cooldown (minutos) para não reenviar o mesmo alerta
ALERTA_COOLDOWN_MINUTOS=30

# ---- Banco de dados ----------------------------------------
DB_PATH=farmtech_iot.db

# ---- Defaults da Fase 1 (clima) ----------------------------
CLIMA_LAT_DEFAULT=-30.03
CLIMA_LON_DEFAULT=-51.23
