dados_teste/
test_data/

# Arquivos de análise temporária
analises_temp/

.idea/

# ============================================
# ✅ REGRAS DE EXCEÇÃO
# ============================================
# Documentação e arquivos essenciais do projeto

# README e documentação
!README.md
!README_STATUS_PROJETO.md
!INSTRUCOES_CONEXAO.md
!*.md

# Arquivos de exemplo (SEMPRE commitar)
!.env.example
!.Renviron.example
!config.example.py
!config.example.yml


# Scripts SQL importantes
!database/*.sql

# Scripts R (SEM credenciais)
!*.R
!an_est_R.R

# Estrutura de pastas (manter vazias)
!*/.gitkeep

# ============================================
# 🔍 REGRAS ESPECÍFICAS POR PASTA
# ============================================

# Manter estrutura, mas ignorar conteúdo temporário
src/ml/experiments/*
!src/ml/experiments/.gitkeep

# PDFs da FIAP (manter)
!*.pdf
!1TIAO*.pdf

# ============================================
# 🎯 REGRAS FINAIS
# ============================================

# Ignorar tudo em temp/, mas manter a pasta
temp/*
!temp/.gitkeep

# Ignorar outputs temporários, mas manter estrutura
outputs/temp/*
!outputs/temp/.gitkeep

#
# ============================================
# FIM DO .gitignore
# ============================================